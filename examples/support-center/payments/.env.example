# Server environment only. Never use VITE_ prefixes or commit filled values.
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHREE_SESSION_SECRET=
# Explicit merchant approval of INR test settlement. No Saptdhatu conversion is assumed.
SHREE_SETTLEMENT_CURRENCY=
# Integer INR paise prices approved by the merchant. Leave blank to disable products.
SHREE_GAME_ACCESS_PAISE=
SHREE_DIGITAL_ITEM_PAISE=
SHREE_ARTICLE_PAISE=
SHREE_PORT=4181
# Optional absolute ledger path; one server process per ledger.
SHREE_DATA_DIR=
