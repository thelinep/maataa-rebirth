{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAATAA Desktop · Tauri Trial",
  "version": "0.1.0",
  "identifier": "in.maataa.desktop.tauri-trial",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "MAATAA Desktop · Tauri Trial", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 620, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
