    "test": "node --test"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@maataa/core": "workspace:*",
    "@maataa/contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}