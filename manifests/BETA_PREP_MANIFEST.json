{
  "schemaVersion": 2,
  "package": "@maataa/ui",
  "version": "1.0.0-alpha.8.7",
  "stage": "DEVELOPMENT_UNQUALIFIED",
  "baselineCertification": {
    "status": "STALE",
    "reason": "Historical evidence does not certify the current source commit"
  },
  "releaseEvidence": {
    "status": "NOT_RUN",
    "workflow": "pnpm certify:enterprise",
    "location": ".certification/release-evidence/<commit>/<run-ID>",
    "rule": "Only actual execution against an unchanged clean source commit can qualify an automated gate"
  },
  "betaPrep": {
    "publishability": "PRIVATE_PACKAGE_BLOCKS_PUBLISH"
  },
  "commands": {
    "baseline": "pnpm certify",
    "full": "pnpm certify:enterprise",
    "browserSetup": "pnpm browser:install"
  }
}
