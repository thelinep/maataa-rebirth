{
  "name": "maataa-ui-v3",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "gate:toolchain": "node scripts/check-toolchain.mjs",
    "gate:drift": "node scripts/check-drift.mjs",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "test": "node --test tests/**/*.test.mjs packages/*/test/*.test.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:control": "node --test tests/control/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:a11y": "node --test tests/accessibility/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "build": "node scripts/build.mjs",
    "certify:kernel": "npm run gate:m0 && npm run gate:toolchain && npm run gate:version-sync && npm run gate:drift && npm run check:registry-bindings && npm run check:react-policy && npm run check:compat && npm run lint && npm run format:check && npm run check:boundaries && npm run check:exports && npm test && npm run build",
    "fresh-clone": "node scripts/fresh-clone.mjs",
    "certify": "node scripts/certify.mjs",
    "report:certification": "node scripts/generate-certification-report.mjs",
    "release:check": "node scripts/release-check.mjs",
    "serve": "node scripts/serve.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "generate:registry": "node scripts/generate-registry.mjs",
    "generate:api": "node scripts/generate-api-manifest.mjs",
    "check:contracts-compat": "node scripts/check-contract-compat.mjs",
    "check:api-compat": "node scripts/check-api-compat.mjs",
    "check:registry-compat": "node scripts/check-registry-compat.mjs",
    "check:deprecations": "node scripts/check-deprecations.mjs",
    "check:compat": "npm run check:contracts-compat && npm run check:api-compat && npm run check:registry-compat && npm run check:deprecations",
    "test:compat": "node --test tests/compatibility/*.test.mjs",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "gate:m0": "node scripts/check-m0-foundation.mjs",
    "gate:version-sync": "node scripts/check-version-sync.mjs",
    "check:registry-bindings": "node scripts/check-registry-bindings.mjs",
    "check:react-policy": "node scripts/check-react-policy.mjs",
    "gate:browser-runtime": "node scripts/check-browser-runtime.mjs",
    "test:react": "node --test packages/react/test/*.test.mjs",
    "test:browser": "node scripts/browser-certify.mjs",
    "certify:browser": "node scripts/browser-certify.mjs",
    "visuals:update": "node scripts/update-visual-baselines.mjs",
    "certify:m2": "npm run gate:browser-runtime && npm run check:react-policy && npm run test:react && npm run certify:browser"
  }
}
