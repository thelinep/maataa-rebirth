{
  "name": "@maataa/ui",
  "version": "1.0.0-alpha.0",
  "maataaPolicy": {
    "versioning": "independent",
    "apiManifest": "separate-typescript-package",
    "classification": "visual-host-package"
  },
  "description": "MAATAA visual UI package, composed from @maataa/tokens and @maataa/primitives",
  "author": "MAATAA UI Team",
  "license": "MIT",
  "homepage": "https://github.com/maataa/maataa-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/maataa/maataa-ui.git"
  },
  "bugs": {
    "url": "https://github.com/maataa/maataa-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./master-registry": {
      "types": "./dist/masterPrimitiveRegistry.d.ts",
      "default": "./dist/masterPrimitiveRegistry.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./typography": {
      "types": "./dist/typography/index.d.ts",
      "default": "./dist/typography/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces/index.d.ts",
      "default": "./dist/surfaces/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "default": "./dist/navigation/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "default": "./dist/maps/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "default": "./dist/effects/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./trust": {
      "types": "./dist/trust/index.d.ts",
      "default": "./dist/trust/index.js"
    },
    "./devices": {
      "types": "./dist/devices/index.d.ts",
      "default": "./dist/devices/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./topology": {
      "types": "./dist/topology/index.d.ts",
      "default": "./dist/topology/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./hud": {
      "types": "./dist/hud/index.d.ts",
      "default": "./dist/hud/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "default": "./dist/knowledge/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "default": "./dist/code/index.js"
    },
    "./notebook": {
      "types": "./dist/notebook/index.d.ts",
      "default": "./dist/notebook/index.js"
    },
    "./whiteboard": {
      "types": "./dist/whiteboard/index.d.ts",
      "default": "./dist/whiteboard/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "default": "./dist/deploy/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "default": "./dist/mobile/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./types": {
      "types": "./dist/trust/types.d.ts",
      "default": "./dist/trust/types.js"
    }
  },
  "keywords": [
    "maataa",
    "ui",
    "component-library",
    "react",
    "typescript",
    "design-system",
    "components",
    "accessible",
    "wcag",
    "storybook"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --fix --ext .ts,.tsx",
    "format": "prettier --write src/ .storybook",
    "format:check": "prettier --check src/ .storybook",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "storybook serve storybook-static",
    "clean": "rm -rf dist/ coverage/ .turbo/ storybook-static/",
    "prebuild": "npm run clean && npm run typecheck:strict",
    "pretest": "npm run lint",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@maataa/governance": "*",
    "@maataa/react": "*",
    "@maataa/primitives": "*",
    "@maataa/tokens": "*"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/addon-interactions": "^7.6.0",
    "@storybook/addon-links": "^7.6.0",
    "@storybook/cli": "^7.6.0",
    "@storybook/react": "^7.6.0",
    "@storybook/react-vite": "^7.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "storybook": "^7.6.24",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "private": true
}
